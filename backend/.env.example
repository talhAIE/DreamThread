APP_ENV=development
API_PREFIX=/api/v1
# Neon only for application data. Supabase remains authentication (and optional future voice storage).
# Copy the administrator URL from Neon Connect with connection pooling OFF.
# configure_neon.py generates the three SQL-login URLs below with distinct random passwords.
# Administrator/migration secrets belong only in setup/release environments, never API containers.
ADMIN_DATABASE_URL=postgresql+psycopg://neondb_owner:CHANGE_ME@ep-YOUR_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgresql+psycopg://dreamthread_app:CHANGE_ME@ep-YOUR_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql+psycopg://dreamthread_migrator:CHANGE_ME@ep-YOUR_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
QUEUE_DATABASE_URL=postgresql+psycopg://dreamthread_claimer:CHANGE_ME@ep-YOUR_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_SIZE=3
QUEUE_POOL_SIZE=1
DB_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300
EXPECTED_SCHEMA_REVISION=0009_continuity_search_index
# Leave integrations unset until Phase 0 verifies credentials, model IDs and dimensions.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_API_KEY=
# NEBIUS_EXTRACTION_MODEL=
# NEBIUS_REASONING_MODEL=
# NEBIUS_EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
EMBEDDING_VERSION=v1
# Configure exact prefixes from your model card (empty string is valid if explicitly verified).
# EMBEDDING_DOCUMENT_PREFIX=""
# EMBEDDING_QUERY_PREFIX=""
EMBEDDING_PREFIXES_VERIFIED=false
# Conservative per-input token bound: UTF-8 bytes + 32 special-token headroom.
EMBEDDING_INPUT_TOKEN_BUDGET=2048
EMBEDDING_BATCH_BYTE_BUDGET=32768
PROMPT_VERSION=v2
VOICE_ENABLED=false
DEMO_ENABLED=false
MODEL_TIMEOUT_SECONDS=60
NEBIUS_OUTPUT_MODE=json_object
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_CONTEXT_TOKEN_BUDGET=32768
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
AUTH_TIMEOUT_SECONDS=5
MAX_REQUEST_BYTES=131072
USER_REQUEST_RATE_LIMIT=120
AI_DAILY_LIMIT=100
ANONYMOUS_AI_DAILY_LIMIT=5
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_STAGE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_MAX_SECONDS=60
WORKER_POLL_SECONDS=1
WORKER_MAINTENANCE_SECONDS=30
WORKER_SHUTDOWN_SECONDS=10
CHECKPOINT_RETENTION_DAYS=7
USER_REQUEST_RATE_LIMIT=120

# Phase-by-phase configuration and verified setup status: docs/developer-handoff.md.
# Future settings are proposed contracts only; current Settings does not consume them.
# Add typed validation, consumers, Compose mappings and tests before activating these.
# SUPABASE_AUDIO_BUCKET=dreamthread-audio
# SUPABASE_EXPORT_BUCKET=dreamthread-exports
# ASR_PROVIDER=faster_whisper
# ASR_MODEL=small
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# AUDIO_MAX_BYTES=10485760
# AUDIO_MAX_DURATION_SECONDS=180
# AUDIO_SIGNED_URL_TTL_SECONDS=300
# AUDIO_UPLOAD_INTENT_TTL_SECONDS=900
# AUDIO_ABANDONED_TTL_SECONDS=86400
# AUDIO_DELETE_AFTER_CONFIRMATION=true
# EXPORT_TTL_SECONDS=3600
# AGENT_MAX_ROUNDS=4
# AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_CANDIDATE_DREAMS=12
# AGENT_TIMEOUT_SECONDS=90
# AGENT_MAX_OUTPUT_TOKENS=2048
# GRAPH_MAX_NODES=100
# GRAPH_MAX_EDGES=200
