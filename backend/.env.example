APP_ENV=development
API_PREFIX=/api/v1
# Matches the local Compose database. Never use these development credentials remotely.
DATABASE_URL=postgresql+psycopg://dreamthread_app:local-runtime-only@localhost:5432/dreamthread
# Dedicated migration login, a member of dreamthread_owner; never supplied to API containers.
MIGRATION_DATABASE_URL=postgresql+psycopg://dreamthread_migrator:local-migration-only@localhost:5432/dreamthread
# Separate cross-user leasing connection. Never point this at an owner/admin/runtime login.
QUEUE_DATABASE_URL=postgresql+psycopg://dreamthread_claimer:local-queue-only@localhost:5432/dreamthread
CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_SIZE=3
DB_TIMEOUT_SECONDS=3
EXPECTED_SCHEMA_REVISION=0005_embedding_spaces
# Leave integrations unset until Phase 0 verifies credentials, model IDs and dimensions.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_API_KEY=
# NEBIUS_EXTRACTION_MODEL=
# NEBIUS_REASONING_MODEL=
# NEBIUS_EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
EMBEDDING_VERSION=v1
# Configure exact prefixes from your model card (empty string is valid if explicitly verified).
# EMBEDDING_DOCUMENT_PREFIX=""
# EMBEDDING_QUERY_PREFIX=""
EMBEDDING_PREFIXES_VERIFIED=false
# Conservative per-input token bound: UTF-8 bytes + 32 special-token headroom.
EMBEDDING_INPUT_TOKEN_BUDGET=2048
EMBEDDING_BATCH_BYTE_BUDGET=32768
PROMPT_VERSION=v1
VOICE_ENABLED=false
DEMO_ENABLED=false
MODEL_TIMEOUT_SECONDS=60
NEBIUS_OUTPUT_MODE=json_object
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_CONTEXT_TOKEN_BUDGET=32768
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
AUTH_TIMEOUT_SECONDS=5
MAX_REQUEST_BYTES=131072
AI_DAILY_LIMIT=100
ANONYMOUS_AI_DAILY_LIMIT=5
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_STAGE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_MAX_SECONDS=60
WORKER_POLL_SECONDS=1
WORKER_MAINTENANCE_SECONDS=30
WORKER_SHUTDOWN_SECONDS=10
CHECKPOINT_RETENTION_DAYS=7
